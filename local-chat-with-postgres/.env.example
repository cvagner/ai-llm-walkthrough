# PostgreSQL/PostGIS Configuration
POSTGIS_DOCKER_TAG=17-3.6-alpine
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=database
POSTGRES_PORT=5432

# Open WebUI Configuration (port publié sur 127.0.0.1 uniquement)
OPEN_WEBUI_PORT=3000
# Compte administrateur créé au premier démarrage
WEBUI_ADMIN_EMAIL=admin@example.com
WEBUI_ADMIN_PASSWORD=demo
WEBUI_ADMIN_NAME=Admin
# Clé de signature des sessions ; vide = générée au démarrage du conteneur
WEBUI_SECRET_KEY=

# Modèle Ollama de base, téléchargé au démarrage (doit savoir appeler des outils).
# La démo utilise assistant-postgis, dérivé de ce modèle avec le prompt de config/ollama.
OLLAMA_MODEL=qwen2.5:3b

# UID/GID des services sans root (db-mcp, mcpo)
APP_UID=10001
APP_GID=10001
